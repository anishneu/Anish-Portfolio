# Local development — copy to .env (never commit .env)

# --- Option A: Gmail SMTP (works locally; blocked on Render free tier) ---
GMAIL_USER=cyberzerox27@gmail.com
GMAIL_PASS=your_gmail_app_password

# --- Option B: Resend HTTPS API (required for Render free tier) ---
# Sign up at https://resend.com → API Keys → create key
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Anish Portfolio <onboarding@resend.dev>
# (After verifying your domain, use: Anish Portfolio <hello@yourdomain.com>)

PORTFOLIO_CONTACT_TO=cyberzerox27@gmail.com
PORT=5000

# Optional: override Render secret files directory (default: /etc/secrets)
# SECRETS_PATH=/etc/secrets

# Optional: comma-separated Netlify/production origins for CORS
# CORS_ORIGINS=https://anishkuila.netlify.app,https://anishkuila.com
